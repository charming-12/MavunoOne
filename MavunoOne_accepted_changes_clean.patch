+"use client";
+
+import { useEffect, useState } from "react";
+import { AlertTriangle, CheckCircle2, CircleAlert, RefreshCw, ShieldAlert } from "lucide-react";
+
+type Issue = { id: number; errorMessage: string; stackTrace: string | null; route: string | null; userId: number | null; severity: string; isResolved: boolean; emailSentAt: string | null; createdAt: string };
+const formatDate = (value: string) => new Intl.DateTimeFormat("sw-TZ", { dateStyle: "medium", timeStyle: "short", timeZone: "Africa/Dar_es_Salaam" }).format(new Date(value));
+const guidance = (issue: Issue) => issue.errorMessage.toLowerCase().includes("database") ? "Kagua DATABASE_URL, Neon availability na migration status." : issue.errorMessage.toLowerCase().includes("payment") ? "Kagua merchant configuration, provider API credentials na transaction reference." : issue.route?.includes("hardware") || issue.route?.includes("cctv") ? "Kagua device power, network/IP, gateway URL na test ya Hardware page." : "Kagua route, browser console, Render logs na reproduce hatua iliyosababisha issue.";
+
+export default function TechnicalIssuesPage() {
+  const [issues, setIssues] = useState<Issue[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState<number | null>(null);
+  const load = async () => { setLoading(true); try { const response = await fetch("/api/admin/technical-issues", { cache: "no-store" }); const data = await response.json(); setIssues(data.issues ?? []); } finally { setLoading(false); } };
+  useEffect(() => {
+    let active = true;
+    fetch("/api/admin/technical-issues", { cache: "no-store" })
+      .then(async (response) => response.json())
+      .then((data) => { if (active) setIssues(data.issues ?? []); })
+      .catch(() => undefined)
+      .finally(() => { if (active) setLoading(false); });
+    return () => { active = false; };
+  }, []);
+  const resolve = async (id: number) => { setBusy(id); try { await fetch("/api/admin/technical-issues", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id }) }); await load(); } finally { setBusy(null); } };
+  const open = issues.filter((issue) => !issue.isResolved);
